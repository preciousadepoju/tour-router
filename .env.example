# Qloo hackathon key. Leave empty to run in SAMPLE mode (local fixtures, clearly labeled in the UI).
QLOO_API_KEY=
# Hackathon keys only work against this base URL.
QLOO_API_URL=https://hackathon.api.qloo.com

# Anthropic key for the stop reasons and the "Without Qloo" baseline.
# Leave empty and the app falls back to template reasons and disables the baseline.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5). claude-haiku-5-5 is much cheaper.
ANTHROPIC_MODEL=

# Optional: show the raw-response debug panel in production builds (it is always on in `next dev`).
NEXT_PUBLIC_DEBUG=
